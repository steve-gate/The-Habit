{
  "name": "the-habit-mosaic-desktop",
  "private": true,
  "version": "2.3.8",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rimraf dist release release-local",
    "lint": "tsc --noEmit",
    "dev:web": "tsx server.ts",
    "build:web": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "desktop:dev": "cross-env HABIT_MOSAIC_DESKTOP_DEV=1 vite build && electron .",
    "desktop:local": "rimraf dist release-local && vite build && electron-builder --dir"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21",
    "cross-env": "^7.0.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "rimraf": "^6.0.1"
  },
  "description": "The Habit Mosaic Desktop V23.8 - Life Story + Dreams + Goals + Soul Expression",
  "author": "steve-gate",
  "license": "Apache-2.0",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.stevegates.thehabitmosaic",
    "productName": "The Habit Mosaic",
    "asar": false,
    "directories": {
      "output": "release-local",
      "buildResources": "desktop/assets"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "src/**/*",
      "server.ts",
      "index.html",
      "vite.config.ts",
      "tsconfig.json",
      "metadata.json",
      "firebase-blueprint.json",
      ".env.example",
      ".gitignore",
      "package.json"
    ],
    "win": {
      "icon": "desktop/assets/icon.ico"
    }
  }
}
